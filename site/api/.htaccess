# Trend Events API — send every /api/... request to index.php
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]

# Never serve the config or helper files directly
<FilesMatch "^(config|config\.example|lib|admin|content)\.php$|\.md$">
  Require all denied
</FilesMatch>

Options -Indexes
